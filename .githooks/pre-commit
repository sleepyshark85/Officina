#!/bin/sh
# The local gate before a commit: the format check and the build, which CI would otherwise fail later. A commit
# that stages no code or build file skips it. Both check the working tree, so a staged code file must not also have
# unstaged changes, or the commit could differ from what was checked.
code='\.(cs|csproj|props|targets|slnx|editorconfig)$|(^|/)global\.json$'
staged=$(git diff --cached --name-only | grep -E "$code") || exit 0

partly=$(git diff --name-only | grep -Fx "$staged")
if [ -n "$partly" ]; then
    echo "pre-commit: these staged files also have unstaged changes; stage or stash them first:" >&2
    echo "$partly" >&2
    exit 1
fi

echo "pre-commit: checking the format..." >&2
if ! dotnet format --verify-no-changes >&2; then
    echo "pre-commit: run 'dotnet format', then commit again." >&2
    exit 1
fi

echo "pre-commit: building (warnings are errors)..." >&2
if ! dotnet build --configuration Release --no-restore --nologo --verbosity quiet >&2; then
    echo "pre-commit: the build fails; fix it, then commit again." >&2
    exit 1
fi
