<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Sleepyshark.Officina\Sleepyshark.Officina.csproj" />
    <ProjectReference Include="..\..\src\Sleepyshark.Officina.Claude\Sleepyshark.Officina.Claude.csproj" />
    <ProjectReference Include="..\..\src\Sleepyshark.Officina.Mcp\Sleepyshark.Officina.Mcp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Npgsql" />
    <!-- The exporter is the host's choice (EVT-02): OpenTelemetry to the dashboard in compose.yaml (APP-20). -->
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json;appsettings.Local.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- A deleted local settings file must not live on in the output, API key included. -->
  <Target Name="RemoveStaleLocalSettings" AfterTargets="Build" Condition="!Exists('appsettings.Local.json')">
    <Delete Files="$(OutDir)appsettings.Local.json" />
  </Target>

</Project>
