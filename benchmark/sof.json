{
  "$schema": "../docs/officina.schema.json",
  // The team every benchmark run uses: the coding team preset, on a .NET project.
  "extends": ["preset:coding-team"],
  "project": {
    "name": "benchmark",
    "values": { "buildCommand": "dotnet build", "testCommand": "dotnet test" }
  },
  // A list replaces the preset's, so its rules are repeated. Packages come from NuGet. Every goal starts from an empty repository,
  // so making projects, solutions and references is allowed with build, test and restore, and the SDK's information. Any other
  // command, such as dotnet run or dotnet tool, is asked about, and a run declines it.
  "capabilities": {
    "sandbox": {
      "allowedHosts": ["api.nuget.org", "*.nuget.org"],
      "commandRules": [
        { "match": "git push*", "action": "deny" },
        { "match": "git remote*", "action": "deny" },
        { "match": "dotnet build", "action": "allow" },
        { "match": "dotnet build *", "action": "allow" },
        { "match": "dotnet test", "action": "allow" },
        { "match": "dotnet test *", "action": "allow" },
        { "match": "dotnet restore", "action": "allow" },
        { "match": "dotnet restore *", "action": "allow" },
        { "match": "dotnet new", "action": "allow" },
        { "match": "dotnet new *", "action": "allow" },
        { "match": "dotnet add *", "action": "allow" },
        { "match": "dotnet sln *", "action": "allow" },
        { "match": "dotnet --version", "action": "allow" },
        { "match": "dotnet --info", "action": "allow" },
        { "match": "dotnet --list-sdks", "action": "allow" },
        { "match": "dotnet --list-runtimes", "action": "allow" }
      ]
    }
  }
}
