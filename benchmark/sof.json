{
  "$schema": "../docs/officina.schema.json",
  // The team every benchmark run uses: the coding team preset, on a .NET project.
  "extends": ["preset:coding-team"],
  "project": {
    "name": "benchmark",
    "values": { "buildCommand": "dotnet build", "testCommand": "dotnet test" }
  },
  // Packages come from NuGet. The command rules are the preset's: every command runs in the sandbox but git push and git remote.
  "capabilities": {
    "sandbox": {
      "allowedHosts": ["api.nuget.org", "*.nuget.org"]
    }
  }
}
