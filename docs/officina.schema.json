{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sleepyshark85/Officina/main/docs/officina.schema.json",
  "title": "Officina configuration",
  "description": "Generated from the Options classes of Sleepyshark.Officina.Core; see docs/configuration-settings.md.",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "The JSON Schema of the file, for editor completion. Files only.",
      "type": "string"
    },
    "extends": {
      "description": "Other files, relative to this one, that this file builds on. Each is a lower layer; later entries override earlier ones. Files only.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "examples": [
        [
          "base.json"
        ]
      ]
    },
    "formatVersion": {
      "description": "The configuration format version. Unknown versions are rejected.",
      "type": [
        "integer",
        "null"
      ],
      "examples": [
        1
      ],
      "default": 1
    },
    "project": {
      "description": "The project's identity, and values usable in placeholders (CFG-14).",
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "name": {
          "description": "The project's name. Usable as `{{project.name}}`.",
          "type": [
            "string",
            "null"
          ],
          "examples": [
            "invoice-api"
          ]
        },
        "values": {
          "description": "Free-form text values. Usable as `{{project.values.<name>}}`.",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "string"
          },
          "examples": [
            {
              "testCommand": "dotnet test"
            }
          ],
          "default": {}
        }
      },
      "additionalProperties": false,
      "examples": [
        {
          "name": "invoice-api"
        }
      ],
      "default": {
        "values": {}
      }
    },
    "providers": {
      "description": "Model providers, by name.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "object",
        "properties": {
          "apiKey": {
            "description": "The provider's credential, as the name of a secret. A literal key is rejected (CFG-09).",
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "secret": {
                "description": "The secret's name: letters, digits and underscores.",
                "type": [
                  "string",
                  "null"
                ],
                "examples": [
                  "ANTHROPIC_API_KEY"
                ]
              }
            },
            "additionalProperties": false,
            "examples": [
              {
                "secret": "ANTHROPIC_API_KEY"
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "examples": [
        {
          "claude": {
            "apiKey": {
              "secret": "ANTHROPIC_API_KEY"
            }
          }
        }
      ],
      "default": {
        "claude": {
          "apiKey": {
            "secret": "ANTHROPIC_API_KEY"
          }
        }
      }
    },
    "models": {
      "description": "Model profiles, by name. Agents refer to them by name (MDL-02, MDL-03).",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "object",
        "properties": {
          "provider": {
            "description": "The provider that serves this profile, by its name in `providers`.",
            "type": [
              "string",
              "null"
            ],
            "examples": [
              "claude"
            ],
            "default": "claude"
          },
          "model": {
            "description": "The provider's model id.",
            "type": [
              "string",
              "null"
            ],
            "examples": [
              "claude-opus-5-5"
            ],
            "default": "claude-opus-5-5"
          },
          "effort": {
            "description": "Reasoning effort, such as `low`, `medium` or `high`. Unset uses the provider's default.",
            "type": [
              "string",
              "null"
            ],
            "examples": [
              "high"
            ]
          },
          "maxOutputTokens": {
            "description": "The most tokens one reply may have. Unset uses the provider's default.",
            "type": [
              "integer",
              "null"
            ],
            "examples": [
              64000
            ],
            "minimum": 1
          },
          "toolChoice": {
            "description": "Whether the model may call tools: `auto` or `none`.",
            "type": [
              "string",
              "null"
            ],
            "examples": [
              "auto"
            ],
            "default": "auto"
          },
          "settings": {
            "description": "Any other setting the provider declares for the model, such as a temperature (MDL-02).",
            "type": [
              "object",
              "null"
            ],
            "examples": [
              {
                "temperature": 0.2
              }
            ],
            "default": {}
          },
          "fallbacks": {
            "description": "Profiles to use instead, in order, when this one is unavailable (MDL-04).",
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "examples": [
              [
                "backup"
              ]
            ],
            "default": []
          }
        },
        "additionalProperties": false
      },
      "examples": [
        {
          "strong": {
            "effort": "high"
          }
        }
      ],
      "default": {
        "default": {
          "provider": "claude",
          "model": "claude-opus-5-5",
          "toolChoice": "auto",
          "settings": {},
          "fallbacks": []
        }
      }
    },
    "agents": {
      "description": "Agent definitions, by name (CFG-01).",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "object",
        "properties": {
          "extends": {
            "description": "Another agent definition this one builds on (CFG-05). Its settings are the lower layer; cycles are rejected. Files only.",
            "type": "string",
            "examples": [
              "base-coder"
            ]
          },
          "description": {
            "description": "What the agent is for. Usable in instructions as `{{agent.description}}`.",
            "type": [
              "string",
              "null"
            ],
            "examples": [
              "Implements one task."
            ]
          },
          "instructions": {
            "description": "The agent's job. Required: only the application knows it (CFG-17). Placeholders may use the `project` and `agent` namespaces only (CFG-14).",
            "type": [
              "string",
              "null"
            ],
            "examples": [
              "Extract the invoice number, date and total. Reply as JSON."
            ]
          },
          "model": {
            "description": "The name of the model profile the agent runs on (MDL-03).",
            "type": [
              "string",
              "null"
            ],
            "examples": [
              "strong"
            ],
            "default": "default"
          }
        },
        "additionalProperties": false
      },
      "examples": [
        {
          "extractor": {
            "instructions": "Extract the invoice number."
          }
        }
      ],
      "default": {}
    },
    "run": {
      "description": "Defaults for every run.",
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "budget": {
          "description": "The run's budget. It can be high, but never removed or unlimited (RUN-05). Live: the owner may change it during a run. Cannot be removed or unlimited (INV-07).",
          "type": "object",
          "properties": {
            "cost": {
              "description": "The most the run may spend, in USD. Live: the owner may change it during a run. Cannot be removed or unlimited (INV-07).",
              "type": "number",
              "examples": [
                25
              ],
              "default": 25,
              "exclusiveMinimum": 0
            },
            "time": {
              "description": "The longest the run may take: a number with a unit, `ms`, `s`, `m`, `h` or `d`. Live: the owner may change it during a run. Cannot be removed or unlimited (INV-07).",
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?(ms|s|m|h|d)$",
              "examples": [
                "8h"
              ],
              "default": "8h"
            }
          },
          "additionalProperties": false,
          "examples": [
            {
              "cost": 25,
              "time": "8h"
            }
          ],
          "default": {
            "cost": 25,
            "time": "8h"
          }
        },
        "permissionMode": {
          "description": "How tool calls that need permission are decided: `ask` the owner, `auto` by the rules, or `readOnly` (HITL-01). Live: the owner may change it during a run.",
          "enum": [
            "ask",
            "auto",
            "readOnly",
            null
          ],
          "examples": [
            "ask"
          ],
          "default": "ask"
        }
      },
      "additionalProperties": false,
      "examples": [
        {
          "permissionMode": "ask"
        }
      ],
      "default": {
        "budget": {
          "cost": 25,
          "time": "8h"
        },
        "permissionMode": "ask"
      }
    }
  },
  "additionalProperties": false
}
