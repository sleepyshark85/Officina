# Bookshop Assistant's settings for this machine. Copy this file to .env beside it and uncomment what you change;
# each line below holds the default. The .env file is git-ignored, so it is never committed, and a variable set in the
# shell wins over it. Keep the API key in the shell's ANTHROPIC_API_KEY or sign in with `ant auth login`, where every
# tool finds it; an ANTHROPIC_API_KEY line in .env works too.

# The PostgreSQL database, a URL: the compose file's, with its demo password.
# BOOKSHOP_DATABASE=postgres://bookshop:shelf-demo-41@localhost:5432/bookshop

# The telemetry dashboard that /audit links each run's trace to.
# BOOKSHOP_DASHBOARD=http://localhost:18888

# The export server's MCP endpoint; empty runs the assistant without exports.
# BOOKSHOP_EXPORTS=http://localhost:18800/mcp

# A reply's budget in US dollars, such as 0.01 to show a budget stop.
# BOOKSHOP_REPLY_BUDGET=0.50

# Where traces, metrics and logs go, over OTLP/HTTP: the compose file's dashboard.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
