#!/usr/bin/env ruby
# frozen_string_literal: true

require 'bookshop'

# The terminal is the staff member's conversation: the OpenTelemetry SDK's own complaints, such as each failed export
# while the dashboard is not running, would land in the middle of it.
OpenTelemetry.logger = Logger.new(File::NULL)

# --demo compacts and clears early enough to see in a short session.
abort 'Usage: bookshop [--demo]' unless (ARGV - ['--demo']).empty?
begin
  application = Bookshop.build(input: $stdin, output: $stdout, demo: ARGV.include?('--demo'))
rescue Bookshop::SettingError => e
  abort e.message
end
begin
  application.run
ensure
  application.close
end
