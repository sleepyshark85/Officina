module Bookshop
  COMPOSE_DATABASE: String
  COMPOSE_DASHBOARD: String

  def self.build: (input: IO, output: IO, ?model: Sleepyshark::Officina::_Model?,
                   ?summarizer: Sleepyshark::Officina::_Model?, ?env: _Settings,
                   ?clock: ^() -> Time, ?telemetry: Telemetry?) -> Application

  # The settings build reads: ENV, or a Hash in tests.
  interface _Settings
    def fetch: (String name, String default) -> String
  end
end
