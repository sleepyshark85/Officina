module Bookshop
  class AuditView
    Usage: singleton(Sleepyshark::Officina::Usage)

    @table: AuditTable
    @dashboard: String

    def initialize: (table: AuditTable, dashboard: String) -> void
    def show: (String session) -> String

    private

    def trail: (String session, Array[AuditRecord] records) -> String
    def link: (Array[AuditRecord] run) -> String
    def line: (AuditRecord record) -> String
    def outcome: (AuditRecord record) -> String
    def spent: (Sleepyshark::Officina::Usage usage, BigDecimal cost) -> String
    def milliseconds: (Float seconds) -> String
  end
end
