module Bookshop
  class Console
    HELP: String

    @audit: AuditView
    @telemetry: Telemetry
    @approvals: Approvals
    @budgets: Budgets
    @terminal: Terminal
    @sessions: SessionCommands
    @interrupts: Interrupts

    def initialize: (agent: Sleepyshark::Officina::Agent, approvals: Approvals, input: IO, output: IO,
                     clock: ^() -> Time, store: SessionStore, budgets: Budgets, audit: AuditView,
                     telemetry: Telemetry) -> void
    def run: () -> void

    private

    def ask_staff_member: () -> String?
    def converse: (Session session) -> void
    def command: (String command, Session session) -> Session
    def audited: (String command, Session session) -> String
    def argument: (String command) -> String
    def reply: (Session session, String message) -> void
  end
end
