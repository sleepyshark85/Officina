module Bookshop
  class Database
    POOL_SIZE: Integer
    CHECKOUT_TIMEOUT: Integer
    LIMITS: Hash[Symbol, untyped]

    def self.containing: (String? part) -> String?
    def self.nil_if_blank: (String? text) -> String?
    def self.password: (String url) -> String?

    def initialize: (String url) -> void
    def with: [T] () { (PG::Connection) -> T } -> T
    def transaction: [T] () { (PG::Connection) -> T } -> T
    def close: () -> void

    private

    @pool: ConnectionPool[PG::Connection]

    def connect: (String url) -> PG::Connection
    def revive: (PG::Connection connection) -> void
  end
end
