module Bookshop
  module Spent
    def self.tokens: (Sleepyshark::Officina::Usage usage) -> String
    def self.dollars: (BigDecimal amount) -> String
    def self.budget: (BigDecimal amount) -> String
    def self.thousands: (Integer count) -> String
    def self.decimals: (BigDecimal amount, Integer places) -> String
  end
end
