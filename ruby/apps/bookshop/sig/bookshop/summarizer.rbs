module Bookshop
  class Summarizer
    Officina: singleton(Sleepyshark::Officina)
    INSTRUCTIONS: String
    BUDGET: Sleepyshark::Officina::Budget

    @agent: Sleepyshark::Officina::Agent

    def self.claude: () -> Sleepyshark::Officina::Claude::Model

    def initialize: (model: Sleepyshark::Officina::_Model, clock: ^() -> Time, telemetry: Telemetry) -> void
    def summarize: (Sleepyshark::Officina::Conversation conversation) -> Sleepyshark::Officina::result
  end
end
