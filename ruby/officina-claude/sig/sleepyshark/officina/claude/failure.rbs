module Sleepyshark
  module Officina
    module Claude
      class Failure
        TRANSIENT_TYPES: Array[Symbol]
        TRANSIENT_STATUSES: Array[Integer]
        AUTHENTICATION_TYPES: Array[Symbol]
        AUTHENTICATION_STATUSES: Array[Integer]
        FIRST_BACKOFF: Float
        LONGEST_WAIT: Float

        @error: StandardError
        @answer: Anthropic::Errors::APIStatusError?

        def initialize: (StandardError error) -> void

        def transient?: () -> bool

        def prompt_too_long?: () -> bool

        def wait: (Integer attempt) -> Float

        def error: (Integer attempts) -> Error

        private

        def retry_after: () -> Integer?
      end
    end
  end
end
