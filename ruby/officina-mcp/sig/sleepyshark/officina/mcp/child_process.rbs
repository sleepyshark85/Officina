module Sleepyshark
  module Officina
    module Mcp
      class ChildProcess
        EXIT_WAIT: Integer
        ERRORS_WAIT: Integer
        ERRORS_KEPT: Integer
        WINDOWS: bool
        GROUP: Hash[Symbol, bool]

        class Reader
          @pipe: IO
          @thread: Thread

          def initialize: (IO pipe) { (IO pipe) -> void } -> void

          def ended_within?: (Numeric timeout) -> bool

          def stop: () -> void
        end

        class ErrorTail
          @mutex: Thread::Mutex
          @bytes: String

          def initialize: () -> void

          def read: (IO pipe) -> void

          def last_line: () -> String?
        end

        @writing: Thread::Mutex
        @error_tail: ErrorTail
        @input: IO
        @exit: Process::Waiter
        @errors_reader: Reader
        @output_reader: Reader

        def initialize: (Server server, on_message: ^(String message) -> void, on_end: ^(String reason) -> void)
                      -> void

        def write: (String message) -> void

        def stop: (clock: clock) -> void

        private

        def spawn_server: (Server server) -> [IO, IO, IO, Process::Waiter]

        def read_output: (IO output, ^(String message) -> void on_message, ^(String reason) -> void on_end) -> void

        def too_long: (^(String reason) -> void on_end) -> void

        def last_error_line: () -> String?

        def exited_within?: (Numeric seconds, clock: clock) -> bool

        def kill: () -> void

        def signal: (Integer pid) -> void
      end
    end
  end
end
