module Sleepyshark
  module Officina
    module Mcp
      class Stdio
        class Pending < Data
          attr_reader transport: Stdio
          attr_reader id: Integer?
          attr_reader queue: Thread::Queue[Wire::Response]

          def self.new: (Stdio transport, Integer? id, Thread::Queue[Wire::Response] queue) -> instance

          def take: (Float? timeout) -> Wire::Response?

          def release: () -> void
        end

        @name: String
        @mutex: Thread::Mutex
        @waiting: Hash[Integer, Thread::Queue[Wire::Response]]
        @lost: String?
        @process: ChildProcess

        def initialize: (Server server, clock: clock) -> void

        def post: (String text, Integer? id, String? _version) -> Pending

        def lost?: () -> bool

        def lost: () -> String

        def forget: (Integer? id) -> Thread::Queue[Wire::Response]?

        def close: () -> void

        private

        def register: (Integer? id) -> Pending

        def write: (String text) -> void

        def dispatch: (String message) -> void

        def lose: (String reason) -> void

        def lost_reason: () -> String
      end
    end
  end
end
