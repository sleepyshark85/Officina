module Sleepyshark
  module Officina
    module Mcp
      class StreamableHttp
        FAILURES: Array[singleton(Exception)]
        OPEN_TIMEOUT: Integer

        class Pending < Data
          attr_reader transport: StreamableHttp
          attr_reader http: Net::HTTP
          attr_reader worker: Thread

          def self.new: (StreamableHttp transport, Net::HTTP http, Thread worker) -> instance

          def take: (Float? timeout) -> Hash[String, json]?

          def release: () -> void

          private

          def stop: () -> void
        end

        @name: String
        @uri: URI::HTTP
        @headers: Hash[String, String]
        @mutex: Thread::Mutex
        @session: String?
        @lost: String?

        def initialize: (Server server) -> void

        def post: (String text, Integer? id, String version) -> Pending

        def lose: (String reason) -> String

        def close: () -> void

        private

        def lost_reason: () -> String

        def build: (String text, String version) -> Net::HTTP::Post

        def connection: () -> Net::HTTP

        def exchange: (Net::HTTP http, Net::HTTP::Post request, Integer? id) -> Hash[String, json]

        def raise_unless_ok: (Net::HTTPResponse response, Net::HTTP::Post request) -> void

        def keep_session: (Net::HTTPResponse response) -> void

        def answer: (Net::HTTPResponse response, Integer id) -> Hash[String, json]
      end
    end
  end
end
