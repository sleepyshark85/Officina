module Sleepyshark
  module Officina
    # What a run yields to the host, in the order it happened.
    type run_event = TextDelta | UsageReported | Retried | ConversationAppended | tool_event

    # How a run ended.
    type result = Completed | Stopped | Failed

    class Agent
      attr_reader model: _Model
      attr_reader instructions: String
      attr_reader tools: Array[Tool]
      attr_reader fingerprint: String
      attr_reader approver: _Approver?
      attr_reader audit_sink: _AuditSink?
      attr_reader name: String?
      attr_reader clock: ^() -> Time
      attr_reader telemetry: Telemetry

      @secrets: Secrets

      def initialize: (model: _Model, instructions: String, ?tools: Array[Tool], ?approver: _Approver?,
                       ?audit_sink: _AuditSink?, ?name: String?, ?secrets: Array[String], ?clock: (^() -> Time)?,
                       ?telemetry: Telemetry?) -> void

      def tool: (String name) -> Tool?

      def redact: (String text) -> String

      def run: (Conversation conversation, String input, ?context: String?, ?cancel: Cancellation?, ?budget: Budget?,
                ?memory_scope: String?) ?{ (run_event event) -> void } -> result

      private

      def check_run: (String input, String? context, Budget? budget) -> void

      def check_memory: (String? scope) -> void

      def keep_prefix: (_Model model, String instructions, Array[Tool] tools) -> void

      def given: (String instructions) -> String

      def sorted: (Array[Tool] tools) -> Array[Tool]

      def prefix_fingerprint: (String settings) -> String
    end
  end
end
