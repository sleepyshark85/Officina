module Sleepyshark
  module Officina
    class AuditRecorder
      MAX_TEXT: Integer

      @agent: Agent
      @conversation: String
      @run: String
      @sequence: Integer
      @lock: Thread::Mutex
      @trace: RunTrace

      def initialize: (agent: Agent, conversation: Conversation, trace: RunTrace) -> void

      def record: (Symbol kind, ?call: ToolCall?, ?span: OpenTelemetry::Trace::Span?, ?detail: String?,
                   **untyped fields) -> bool

      def record_end: (result? result, Usage usage, BigDecimal cost) -> bool

      def record_edit: (ConversationCompacted | ToolResultsCleared event) -> bool

      private

      def entry: (Symbol kind, ToolCall? call, OpenTelemetry::Trace::Span span, String? detail, Hash[Symbol, untyped] fields)
                -> AuditEntry

      def written?: (_AuditSink sink, OpenTelemetry::Trace::Span span, AuditEntry entry) -> bool

      def ids: (OpenTelemetry::Trace::Span span) -> Hash[Symbol, String]?

      def clean: (String? text) -> String?

      def ended: (result? result) -> Hash[Symbol, String?]
    end
  end
end
