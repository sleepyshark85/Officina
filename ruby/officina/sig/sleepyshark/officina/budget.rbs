module Sleepyshark
  module Officina
    class Budget < Data
      attr_reader cost: BigDecimal?
      attr_reader tokens: Integer?
      attr_reader model_calls: Integer?
      attr_reader time: Numeric?

      def self.new: (?cost: BigDecimal?, ?tokens: Integer?, ?model_calls: Integer?, ?time: Numeric?) -> instance

      def initialize: (?cost: BigDecimal?, ?tokens: Integer?, ?model_calls: Integer?, ?time: Numeric?) -> void
    end
  end
end
