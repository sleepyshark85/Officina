module Sleepyshark
  module Officina
    class Request < Data
      attr_reader tools: Array[Tool]
      attr_reader instructions: String
      attr_reader messages: Array[Message]
      attr_reader max_output_tokens: Integer?

      def self.new: (tools: Array[Tool], instructions: String, messages: Array[Message], ?max_output_tokens: Integer?)
                  -> instance

      def initialize: (tools: Array[Tool], instructions: String, messages: Array[Message],
                       ?max_output_tokens: Integer?) -> void
    end
  end
end
