module Sleepyshark
  module Officina
    class RunEngine
      MAX_MODEL_CALLS: Integer
      PREFIX_MISMATCH: String
      STOPPED: Hash[Symbol, Symbol]

      @agent: Agent
      @conversation: Conversation
      @append: ^(Array[Message], String) -> void
      @cancel: Cancellation
      @on_event: (^(run_event) -> void)?
      @usage: Usage
      @model_calls: Integer
      @host_failure: StandardError?

      def initialize: (agent: Agent, conversation: Conversation, append: ^(Array[Message], String) -> void,
                       cancel: Cancellation, on_event: (^(run_event) -> void)?) -> void

      def run: (String input, String? context) -> result

      private

      def call_until_stopped: (Array[Message] pending) -> result

      def call_model: (Array[Message] messages) -> (Reply | Stopped | Failed)

      def relay: (model_event event) -> void

      def emit: (run_event event) -> void

      def cut_off: (String why) -> (Stopped | Failed)

      def take: (Reply reply, Array[Message] pending) -> result?

      def finish:(Reply reply, Array[ToolCall] calls) -> result?

      def append: (*Message messages) -> void

      def unrunnable: (ToolCall call) -> Block

      def text_message: (Symbol role, String text) -> Message

      def stopped: (Symbol reason, ?String? detail) -> Stopped

      def failed: (Symbol reason, String detail) -> Failed
    end
  end
end
