module Sleepyshark
  module Officina
    class RunEngine
      MAX_MODEL_CALLS: Integer
      PREFIX_MISMATCH: String

      @agent: Agent
      @conversation: Conversation
      @reporter: Reporter
      @cancel: Cancellation
      @usage: Usage
      @model_calls: Integer
      @tool_calls: Integer
      @trace: RunTrace
      @host_raised: bool?
      @audit: AuditRecorder
      @tool_step: ToolStep

      def initialize: (agent: Agent, conversation: Conversation, append: ^(Array[Message], String) -> void,
                       cancel: Cancellation, on_event: (^(run_event) -> void)?, trace: RunTrace) -> void

      def run: (String input, String? context) -> result

      private

      def decide: (String input, String? context) -> result

      def call_until_stopped: (Array[Message] pending) -> result

      def step: (Array[Message] pending) -> result?

      def call_model: (Array[Message] messages) -> (Reply | Failed | nil)

      def stream: (Request request) -> (Reply | Failed | nil)

      def relay: (model_event event) -> void

      def no_reply: (String why) -> Failed?

      def after_reply: (Reply reply, Array[Message] pending) -> result?

      def rejected?: (Reply reply, Array[ToolCall] calls, result? result) -> boolish

      def keep: (Reply reply, Array[Message] pending, Array[ToolCall] calls) -> void

      def redacted: (result result) -> result

      def text_message: (Symbol role, String text) -> Message

      def stopped: (Symbol reason) -> Stopped

      def failed: (Symbol reason, String detail) -> Failed
    end
  end
end
