module Sleepyshark
  module Officina
    class Secrets
      REDACTED: String
      ESCAPED: Array[Regexp?]

      @forms: Array[String]

      def initialize: (Array[String] secrets) -> void

      def redact: (String text) -> String

      private

      def forms: (String secret) -> Array[String]

      def json: (String secret, Regexp? pattern, String hex) -> String

      def starts: (String text, String form) -> Array[Integer]

      def redacted: (String text, Array[[Integer, Integer]] spans) -> String
    end
  end
end
