module Sleepyshark
  module Officina
    class Tool
      KINDS: Array[Symbol]

      # A tool's input type: a Schema, or a class from Input.define.
      interface _Input
        def schema: () -> Schema

        def from_json: (untyped value) -> untyped
      end

      @input: _Input
      @needs_approval: bool
      @handler: ^(untyped input, Cancellation cancel, String? memory_scope) -> untyped

      attr_reader name: String
      attr_reader description: String
      attr_reader kind: Symbol

      def initialize: (name: String, description: String, input: _Input, kind: Symbol,
                       ?needs_approval: bool) { (untyped input, Cancellation cancel, String? memory_scope) -> untyped } -> void

      def input_schema: () -> String

      def needs_approval?: () -> bool

      def needs_approval_for?: (String input) -> bool

      def memory?: () -> bool

      def write?: () -> bool

      def input_problem: (String input) -> String?

      def invoke: (String input, Cancellation cancel, ?String? memory_scope) -> (String | ToolFailure)

      private

      def check: (String name, Symbol kind, (^(untyped, Cancellation, String?) -> untyped)? handler) -> void
    end
  end
end
