module Sleepyshark
  module Officina
    class ToolStep
      @agent: Agent
      @audit: AuditRecorder
      @trace: RunTrace
      @cancel: Cancellation
      @reporter: Reporter
      @sources: ToolSources

      def initialize: (agent: Agent, audit: AuditRecorder, trace: RunTrace, cancel: Cancellation, reporter: Reporter)
                    -> void

      def connect_sources: () -> String?

      def call: (Array[ToolCall] calls) { () -> void } -> void

      private

      def append_results: (ToolPipeline? pipeline, Array[ToolCall] calls, bool reported) -> void

      def start_pipeline: (Array[ToolCall] calls) -> ToolPipeline
    end
  end
end
