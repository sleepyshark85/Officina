<Project Sdk="Microsoft.NET.Sdk">

  <!-- Core depends on the .NET base library and a JSON Schema validator only (TEST-32). -->
  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" />
  </ItemGroup>

  <!-- The presets shipped with the core (CFG-11). -->
  <ItemGroup>
    <EmbeddedResource Include="Presets\*.json" LogicalName="Sleepyshark.Officina.Core.Presets.%(Filename).json" />
  </ItemGroup>

</Project>
