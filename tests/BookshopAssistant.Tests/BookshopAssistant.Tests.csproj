<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\apps\BookshopAssistant\BookshopAssistant.csproj" />
    <ProjectReference Include="..\..\src\Sleepyshark.Officina.Testing\Sleepyshark.Officina.Testing.csproj" />
  </ItemGroup>

  <!-- Test only: the database in Docker (TEST-09), property tests (TEST-07) and a fake clock. -->
  <ItemGroup>
    <PackageReference Include="CsCheck" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Testcontainers.PostgreSql" />
  </ItemGroup>

  <!-- The core tests' property runner: fixed seeds, shrinking, and replay by OFFICINA_SEED. -->
  <ItemGroup>
    <Compile Include="..\Sleepyshark.Officina.Tests\Property.cs" Link="Property.cs" />
  </ItemGroup>

  <!-- The application's own schema and seed, so the tests run against the database the compose file creates. -->
  <ItemGroup>
    <None Include="..\..\apps\BookshopAssistant\database\*.sql" LinkBase="database" CopyToOutputDirectory="PreserveNewest" />
    <!-- And its compose file, whose filesystem service the export tests start (APP-12). -->
    <None Include="..\..\apps\BookshopAssistant\compose.yaml" Link="compose.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
